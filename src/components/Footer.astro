---
import BrandMark from "./BrandMark.astro";
import { navItems, SITE } from "../data/site";
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <BrandMark />
        <span>{SITE.name}</span>
      </a>
      <p>A private, browser-based way to explore the acoustic features of one voice recording.</p>
    </div>
    <div>
      <strong>Explore</strong>
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div>
      <strong>Contact</strong>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <span>No audio uploads. No accounts.</span>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} {SITE.name}</span>
    <span>This tool is educational, not medical advice.</span>
  </div>
</footer>
